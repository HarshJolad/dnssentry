# Copy this file to .env and fill in your values.
# Create a Personal Access Token (PAT) from https://developer.godaddy.com/en/docs/api-users
# Ensure your token has permissions for reading and managing domains/DNS.

GODADDY_PAT=your_personal_access_token_here

# (Optional) "production" (default) or "ote" to use GoDaddy's test environment
GODADDY_ENV=production

# (Optional) Microsoft 365 tenant name (e.g. mycompany or mycompany.onmicrosoft.com)
# Used to auto-create dual DKIM CNAME records (selector1 & selector2)
# MS_TENANT=your_tenant_name

